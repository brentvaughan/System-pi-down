# Copy this file to .env and fill in real values.

# Flask
SECRET_KEY=change-me
FLASK_DEBUG=false

# Where the SQLite database file lives
DATABASE_PATH=instance/downtime.db

# SMTP server used to send part-order and reminder emails.
# If left blank, emails are logged to the console instead of sent
# (useful while testing on the Pi before mail is configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=downtime-tracker@example.com

# Who gets the periodic "here's what's still down" reminder emails.
# Comma-separate multiple addresses.
REMINDER_EMAIL=you@example.com

# How often (minutes) to send a reminder while something is still down.
REMINDER_INTERVAL_MINUTES=240

# Only send reminders during these hours (24h, local server time),
# so you don't get paged at 3am about a down machine.
REMINDER_ACTIVE_START_HOUR=7
REMINDER_ACTIVE_END_HOUR=19
